FROM python:3.12

ARG GSL_LITE_REF=v1.1.0
ARG NCEPLIBS_BUFR_REF=v12.3.0
ARG BUFR_QUERY_REF=v0.0.5

# Install system dependencies required by BUFR tooling.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      ecbuild \
      gfortran \
      git \
      libeckit-dev \
      libeigen3-dev \
      libnetcdf-c++4-dev \
      libnetcdf-dev \
      libopenmpi-dev \
      libomp-dev \
      pybind11-dev \
        vim \
      emacs \
      openmpi-bin && \
    rm -rf /var/lib/apt/lists/*

# Install gsl-lite headers and NCEPLIBS-bufr from source.
RUN git clone --branch "${GSL_LITE_REF}" --depth 1 \
      https://github.com/gsl-lite/gsl-lite.git /tmp/gsl-lite && \
    cmake -S /tmp/gsl-lite \
      -B /tmp/gsl-lite/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DGSL_LITE_OPT_BUILD_TESTS=OFF && \
    cmake --install /tmp/gsl-lite/build && \
    rm -rf /tmp/gsl-lite

RUN git clone --branch "${NCEPLIBS_BUFR_REF}" --depth 1 \
      https://github.com/NOAA-EMC/NCEPLIBS-bufr.git /tmp/NCEPLIBS-bufr && \
    cmake -S /tmp/NCEPLIBS-bufr -B /tmp/NCEPLIBS-bufr/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/NCEPLIBS-bufr/build -j"$(nproc)" && \
    cmake --install /tmp/NCEPLIBS-bufr/build && \
    rm -rf /tmp/NCEPLIBS-bufr && \
    ldconfig

# Install bufr-query from source
RUN git clone --branch "${BUFR_QUERY_REF}" --depth 1 \
      https://github.com/NOAA-EMC/bufr-query.git /tmp/bufr-query && \
    mkdir /tmp/bufr-query/build && cd /tmp/bufr-query/build && \
    ecbuild ../ && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /tmp/bufr-query

# Install Python dependencies used by this repository.
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir \
      pytest==9.1.1 \
      ruff==0.16.3 \
      pywis-pubsub==0.12.0 \
      requests==2.34.2 \
      netcdf4 \
      xarray>=2025.8.0 \
      icechunk==2.1.2 \
      pybind11==3.0.1 \
      wxflow==0.4.2

# Set default command
CMD ["/bin/bash"]
